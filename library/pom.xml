<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.trethore</groupId>
        <artifactId>jcefgithub-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <groupId>io.github.trethore</groupId>
    <artifactId>jcefgithub</artifactId>
    <version>${revision}</version>
    <packaging>jar</packaging>
    <name>JCEF GitHub</name>
    <description>Install and initialize the Java Chromium Embedded Framework from Maven artifacts</description>
    <url>https://github.com/trethore/jcefgithub</url>
    <licenses><license><name>Apache License 2.0</name><url>https://www.apache.org/licenses/LICENSE-2.0.txt</url></license></licenses>
    <developers><developer><id>trethore</id><name>Trethore</name><url>https://github.com/trethore</url></developer></developers>
    <scm>
        <connection>scm:git:https://github.com/trethore/jcefgithub.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/trethore/jcefgithub.git</developerConnection>
        <url>https://github.com/trethore/jcefgithub</url><tag>HEAD</tag>
    </scm>
    <properties>
        <sha256.linux.amd64>development-build-no-download</sha256.linux.amd64>
        <sha256.linux.arm64>development-build-no-download</sha256.linux.arm64>
        <sha256.windows.amd64>development-build-no-download</sha256.windows.amd64>
        <sha256.windows.arm64>development-build-no-download</sha256.windows.arm64>
        <sha256.macosx.amd64>development-build-no-download</sha256.macosx.amd64>
        <sha256.macosx.arm64>development-build-no-download</sha256.macosx.arm64>
    </properties>
    <dependencies>
        <dependency><groupId>io.github.trethore</groupId><artifactId>jcef-api</artifactId><version>${jcef.version}</version></dependency>
        <dependency><groupId>org.apache.commons</groupId><artifactId>commons-compress</artifactId><version>1.28.0</version></dependency>
        <dependency><groupId>com.google.code.gson</groupId><artifactId>gson</artifactId><version>2.13.1</version></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.13.4</version><scope>test</scope></dependency>
    </dependencies>
    <build>
        <resources><resource><directory>src/main/resources</directory><filtering>true</filtering></resource></resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId><artifactId>flatten-maven-plugin</artifactId><version>1.7.3</version>
                <configuration><flattenMode>ossrh</flattenMode><updatePomFile>false</updatePomFile></configuration>
                <executions><execution><id>flatten</id><phase>process-resources</phase><goals><goal>flatten</goal></goals></execution></executions>
            </plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.1</version><configuration><release>${maven.compiler.release}</release></configuration></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.6</version></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-source-plugin</artifactId><version>3.3.1</version><executions><execution><id>sources</id><goals><goal>jar-no-fork</goal></goals></execution></executions></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-javadoc-plugin</artifactId><version>3.11.2</version><executions><execution><id>javadocs</id><goals><goal>jar</goal></goals></execution></executions></plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.6.1</version>
                <executions><execution><id>fat-jar</id><phase>package</phase><goals><goal>shade</goal></goals><configuration>
                    <shadedArtifactAttached>true</shadedArtifactAttached><shadedClassifierName>all-relocated</shadedClassifierName><createDependencyReducedPom>false</createDependencyReducedPom>
                    <relocations>
                        <relocation><pattern>com.google.gson</pattern><shadedPattern>io.github.trethore.jcefgithub.shaded.gson</shadedPattern></relocation>
                        <relocation><pattern>org.apache.commons.compress</pattern><shadedPattern>io.github.trethore.jcefgithub.shaded.commons.compress</shadedPattern></relocation>
                    </relocations>
                    <filters><filter><artifact>*:*</artifact><excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude></excludes></filter></filters>
                </configuration></execution></executions>
            </plugin>
        </plugins>
    </build>
</project>
